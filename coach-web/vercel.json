{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/entrar", "destination": "/index.html" },
    { "source": "/alunos/:path*", "destination": "/index.html" },
    { "source": "/vinculacao", "destination": "/index.html" }
  ]
}
